PORT=3001
API_KEY=change-me

# Storage: sqlite (default) or postgres. The copy/verify tools open both regardless.
DB_DRIVER=sqlite

# SQLite file (DB_DRIVER=sqlite). Inside the container ./data is the mounted volume.
DATABASE_PATH=./data/person.db

# Postgres (DB_DRIVER=postgres): the `immeyes` database next to Immich, schema `people`
# is created on first start. Host name as seen from the Immich docker network.
#DATABASE_URL=postgres://immeyes:CHANGE_ME@immich_postgres:5432/immeyes

# Docker network of the Immich compose project (docker-compose.yml joins it).
IMMICH_NETWORK=immich_default
